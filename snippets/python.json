	"Pandas Row Operation": {
	 	"prefix": "pandas_row_op_apply_save",
	 	"body": [
			"row[\"$1\"] = $2(row['$3'])"	
		],
	 	"description": "Applies a certain function on a pandas excel row and saves it at the same or different row"
	},

	"Multi Line Comment Declaration": {
		"prefix": "comment_start_multiline",
		"body": [
			"\"\"\"$1\"\"\""
		],
		"description": "Start a python multi line comment"
	},	
	
	"Average if Case": {
		"prefix": "avg_if_case",
		"body": [
			"if $1:",
			"\t$2",
			"else:",
			"\t$3"
		],
		"description": "Creates an Average if case"
	},
		
